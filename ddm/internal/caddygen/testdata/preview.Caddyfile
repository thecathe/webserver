# Generated by ddm from sites.yaml (local preview on port 8080). Do not edit: run `ddm caddyfile`.
{
	admin off
	auto_https off
	default_bind 127.0.0.1 [::1]
}

(errors) {
	handle_errors 404 {
		root * /home/me/.ddm/www/public/docs/current
		rewrite * /404.html
		file_server
	}
}

http://a.b.cathe.dev.localhost:8080 {
	import errors
	handle {
		root * /home/me/.ddm/www/public/deep/current
		file_server
	}
}

http://docs.cathe.dev.localhost:8080 {
	import errors
	redir /guide /guide/
	handle_path /guide/* {
		redir / /guide/intro/
		root * /home/me/.ddm/www/public/guide/current
		file_server
	}
	handle {
		root * /home/me/.ddm/www/public/docs/current
		file_server
	}
}

http://forest.cathe.dev.localhost:8080 {
	import errors
	handle {
		redir / /index/
		root * /home/me/.ddm/www/public/forest/current
		file_server
	}
}

http://jpears.me.localhost:8080 {
	import errors
	handle {
		redir / /@jpears/
		root * /home/me/.ddm/www/public/forest/current
		file_server
	}
}

http://secret.the.cathe.dev.localhost:8080 {
	import errors
	# private: in prod, only your Tailscale identity gets past here
	handle {
		root * /home/me/.ddm/www/public/secret/current
		file_server
	}
}

http://the.cathe.dev.localhost:8080 {
	import errors
	# private: in prod, only your Tailscale identity gets past here
	redir /sites /sites/
	handle_path /sites/* {
		root * /home/me/.ddm/www/private/docs/current
		file_server
	}
	handle {
		redir / /index/
		root * /home/me/.ddm/www/private/forest/current
		file_server
	}
}

http://:8080 {
	import errors
	error 404
}

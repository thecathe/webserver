# Generated by ddm from sites.yaml (local preview on port 8080). Do not edit: run `ddm caddyfile`.
{
	admin off
	auto_https off
	default_bind 127.0.0.1 [::1]
}

(errors) {
	handle_errors 404 {
		root * /home/me/.ddm/www/public/docs/current
		rewrite * /404.html
		file_server
	}
}

http://a.b.cathe.dev.localhost:8080 {
	import errors
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<ROBOTS
			# robots.txt for a.b.cathe.dev, generated by ddm from sites.yaml.
			
			# AI training crawlers: refused everywhere.
			User-agent: GPTBot
			Disallow: /
			
			# AI assistants fetching a page for someone: only where a site allows it.
			User-agent: Claude-User
			Disallow: /
			
			# Everyone else, search engines included.
			User-agent: *
			Content-Signal: search=no, ai-input=no, ai-train=no
			Disallow: /
			ROBOTS 200
	}
	handle_path /_ddm/* {
		root * /home/me/.ddm/www/_ddm/public
		file_server
	}
	handle {
		root * /home/me/.ddm/www/public/deep/current
		file_server
	}
}

http://docs.cathe.dev.localhost:8080 {
	import errors
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<ROBOTS
			# robots.txt for docs.cathe.dev, generated by ddm from sites.yaml.
			
			# AI training crawlers: refused everywhere.
			User-agent: GPTBot
			Disallow: /
			
			# AI assistants fetching a page for someone: only where a site allows it.
			User-agent: Claude-User
			Disallow: /
			
			# Everyone else, search engines included.
			User-agent: *
			Content-Signal: search=yes, ai-input=no, ai-train=no
			Allow: /
			Disallow: /
			ROBOTS 200
	}
	handle_path /_ddm/* {
		root * /home/me/.ddm/www/_ddm/public
		file_server
	}
	redir /guide /guide/
	handle_path /guide/* {
		redir / /guide/intro/
		root * /home/me/.ddm/www/public/guide/current
		file_server
	}
	handle {
		root * /home/me/.ddm/www/public/docs/current
		file_server
	}
}


# Generated by ddm from sites.yaml (production). Do not edit: run `ddm caddyfile`.
{
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

(errors) {
	handle_errors 404 {
		root * /var/www/public/docs/current
		rewrite * /404.html
		file_server
	}
}

*.cathe.dev {
	import errors
	@docs_cathe_dev host docs.cathe.dev
	handle @docs_cathe_dev {
		handle /robots.txt {
			header Content-Type "text/plain; charset=utf-8"
			respond <<ROBOTS
				# robots.txt for docs.cathe.dev, generated by ddm from sites.yaml.
				
				# AI training crawlers: refused everywhere.
				User-agent: GPTBot
				Disallow: /
				
				# AI assistants fetching a page for someone: only where a site allows it.
				User-agent: Claude-User
				Disallow: /
				
				# Everyone else, search engines included.
				User-agent: *
				Content-Signal: search=yes, ai-input=no, ai-train=no
				Allow: /
				Disallow: /
				
				ROBOTS 200
		}
		handle_path /_ddm/* {
			root * /var/www/_ddm/public
			file_server
		}
		redir /guide /guide/
		handle_path /guide/* {
			redir / /guide/intro/
			root * /var/www/public/guide/current
			file_server
		}
		handle {
			root * /var/www/public/docs/current
			file_server
		}
	}
	@forest_cathe_dev host forest.cathe.dev
	handle @forest_cathe_dev {
		handle /robots.txt {
			header Content-Type "text/plain; charset=utf-8"
			respond <<ROBOTS
				# robots.txt for forest.cathe.dev, generated by ddm from sites.yaml.
				
				# AI training crawlers: refused everywhere.
				User-agent: GPTBot
				Disallow: /
				
				# AI assistants fetching a page for someone: only where a site allows it.
				User-agent: Claude-User
				Disallow: /
				
				# Everyone else, search engines included.
				User-agent: *
				Content-Signal: search=yes, ai-input=no, ai-train=no
				Allow: /$
				Allow: /index/$
				Allow: /index/index.html$
				Allow: /_ddm/
				Allow: /fonts/
				Allow: /*.css$
				Allow: /*.js$
				Allow: /*.xsl$
				Disallow: /
				
				ROBOTS 200
		}
		handle_path /_ddm/* {
			root * /var/www/_ddm/public
			file_server
		}
		handle {
			redir / /index/
			root * /var/www/public/forest/current
			file_server
		}
	}
	@lib_cathe_dev host lib.cathe.dev
	handle @lib_cathe_dev {
		handle /robots.txt {
			header Content-Type "text/plain; charset=utf-8"
			respond <<ROBOTS
				# robots.txt for lib.cathe.dev, generated by ddm from sites.yaml.
				
				# AI training crawlers: refused everywhere.
				User-agent: GPTBot
				Disallow: /
				
				# AI assistants fetching a page for someone: only where a site allows it.
				User-agent: Claude-User
				Disallow: /
				
				# Everyone else, search engines included.
				User-agent: *
				Content-Signal: search=no, ai-input=no, ai-train=no
				Disallow: /
				
				ROBOTS 200
		}
		handle_path /_ddm/* {
			root * /var/www/_ddm/public
			file_server
		}
		handle {
			redir / /lib/
			@elsewhere not path / /lib/* /odoc.support/*
			redir @elsewhere https://ocaml.cathe.dev{uri}
			root * /var/www/public/@pooled/current
			file_server
		}
	}
	@ocaml_cathe_dev host ocaml.cathe.dev
	handle @ocaml_cathe_dev {
		handle /robots.txt {
			header Content-Type "text/plain; charset=utf-8"
			respond <<ROBOTS
				# robots.txt for ocaml.cathe.dev, generated by ddm from sites.yaml.
				
				# AI training crawlers: refused everywhere.
				User-agent: GPTBot
				Disallow: /
				
				# AI assistants fetching a page for someone: only where a site allows it.
				User-agent: Claude-User
				Allow: /
				
				# Everyone else, search engines included.
				User-agent: *
				Content-Signal: search=no, ai-input=yes, ai-train=no
				Disallow: /
				
				ROBOTS 200
		}
		handle_path /_ddm/* {
			root * /var/www/_ddm/public
			file_server
		}
		handle {
			root * /var/www/public/@pooled/current
			file_server
		}
	}
	handle {
		error 404
	}
}

*.the.cathe.dev {
	import errors
	route {
		@outside not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
		abort @outside
		request_header -Tailscale-User
		forward_auth unix//run/tailscale-nginx-auth/tailscale-nginx-auth.sock {
			uri /auth
			header_up Remote-Addr {remote_host}
			header_up Remote-Port {remote_port}
			header_up Original-URI {uri}
			copy_headers Tailscale-User
		}
		@notowner expression `{http.request.header.Tailscale-User} != {env.TAILNET_OWNER} || {env.TAILNET_OWNER} == ''`
		error @notowner 403
		header X-Robots-Tag "noindex, nofollow"
		@secret_the_cathe_dev host secret.the.cathe.dev
		handle @secret_the_cathe_dev {
			handle /robots.txt {
				header Content-Type "text/plain; charset=utf-8"
				respond <<ROBOTS
					# robots.txt for secret.the.cathe.dev, generated by ddm from sites.yaml.
					# A private host: tailnet only, and never indexed.
					User-agent: *
					Content-Signal: search=no, ai-input=no, ai-train=no
					Disallow: /
					
					ROBOTS 200
			}
			handle_path /_ddm/* {
				root * /var/www/_ddm/private
				file_server
			}
			handle {
				root * /var/www/public/secret/current
				file_server
			}
		}
		handle {
			error 404
		}
	}
}


# Generated by ddm from sites.yaml (production). Do not edit: run `ddm caddyfile`.
{
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

(errors) {
	handle_errors 404 {
		root * /var/www/public/docs/current
		rewrite * /404.html
		file_server
	}
}

*.cathe.dev {
	import errors
	@docs_cathe_dev host docs.cathe.dev
	handle @docs_cathe_dev {
		redir /guide /guide/
		handle_path /guide/* {
			redir / /guide/intro/
			root * /var/www/public/guide/current
			file_server
		}
		handle {
			root * /var/www/public/docs/current
			file_server
		}
	}
	@forest_cathe_dev host forest.cathe.dev
	handle @forest_cathe_dev {
		handle {
			redir / /index/
			root * /var/www/public/forest/current
			file_server
		}
	}
	@lib_cathe_dev host lib.cathe.dev
	handle @lib_cathe_dev {
		handle {
			redir / /lib/
			root * /var/www/public/@pooled/current
			file_server
		}
	}
	@ocaml_cathe_dev host ocaml.cathe.dev
	handle @ocaml_cathe_dev {
		handle {
			root * /var/www/public/@pooled/current
			file_server
		}
	}
	handle {
		error 404
	}
}

*.the.cathe.dev {
	import errors
	route {
		@outside not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
		abort @outside
		request_header -Tailscale-Login
		forward_auth unix//run/tailscale-nginx-auth/tailscale-nginx-auth.sock {
			uri /auth
			header_up Remote-Addr {remote_host}
			header_up Remote-Port {remote_port}
			header_up Original-URI {uri}
			copy_headers Tailscale-Login
		}
		@notowner expression `{http.request.header.Tailscale-Login} != {env.TAILNET_OWNER} || {env.TAILNET_OWNER} == ''`
		error @notowner 403
		@secret_the_cathe_dev host secret.the.cathe.dev
		handle @secret_the_cathe_dev {
			handle {
				root * /var/www/public/secret/current
				file_server
			}
		}
		handle {
			error 404
		}
	}
}

a.b.cathe.dev {
	import errors
	handle {
		root * /var/www/public/deep/current
		file_server
	}
}

jpears.me {
	import errors
	handle {
		redir / /@jpears/
		root * /var/www/public/forest/current
		file_server
	}
}

the.cathe.dev {
	import errors
	route {
		@outside not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
		abort @outside
		request_header -Tailscale-Login
		forward_auth unix//run/tailscale-nginx-auth/tailscale-nginx-auth.sock {
			uri /auth
			header_up Remote-Addr {remote_host}
			header_up Remote-Port {remote_port}
			header_up Original-URI {uri}
			copy_headers Tailscale-Login
		}
		@notowner expression `{http.request.header.Tailscale-Login} != {env.TAILNET_OWNER} || {env.TAILNET_OWNER} == ''`
		error @notowner 403
		redir /sites /sites/
		handle_path /sites/* {
			root * /var/www/private/docs/current
			file_server
		}
		handle {
			redir / /index/
			root * /var/www/private/forest/current
			file_server
		}
	}
}

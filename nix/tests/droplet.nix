# The droplet's configuration in a VM, offline: the services start and talk
# to each other, and the generated Caddyfile routes and gates as designed.
# Real certificates, the tailnet and site builds need the internet, so they
# are left to the droplet itself.
#
#   nix build .#checks.x86_64-linux.droplet -L
{pkgs, ...}: {
  name = "droplet";

  nodes.droplet = {
    config,
    lib,
    ...
  }: {
    virtualisation.memorySize = 2048;
    services.ddm.tailnetOwner = lib.mkForce "owner@github";
    # The secrets are encrypted to the real droplet's host key, which the VM
    # doesn't have; it needs neither.
    age.secrets = lib.mkForce {};
    services.ddm.cloudflareEnvironmentFile = lib.mkForce null;
    services.ddm.githubTokenFile = lib.mkForce null;
    # No network: nothing to deploy, and the subtests start deploys by hand.
    services.ddm.autoDeploy = lib.mkForce false;
    # Certificates from Caddy's own CA instead of Let's Encrypt via
    # Cloudflare; everything else is the generated config.
    services.caddy.configFile = lib.mkForce (pkgs.runCommand "Caddyfile" {} ''
      sed 's/^\tacme_dns cloudflare .*/\tlocal_certs/' ${config.services.ddm.caddyfile} > $out
    '');
    networking.hosts."127.0.0.1" = ["ddm.cathe.dev" "the.cathe.dev" "nosuch.cathe.dev"];
    # A second network, addressed inside a webSources range, for the
    # outsider below.
    virtualisation.vlans = [1 2];
    networking.interfaces.eth2.ipv4.addresses = lib.mkForce [
      {
        address = "173.245.48.1";
        prefixLength = 20;
      }
    ];
  };

  # A client on the internet: from 192.168.1.x it is anyone, from
  # 173.245.48.2 it is Cloudflare.
  nodes.outsider = {
    lib,
    pkgs,
    ...
  }: {
    virtualisation.vlans = [1 2];
    networking.interfaces.eth2.ipv4.addresses = lib.mkForce [
      {
        address = "173.245.48.2";
        prefixLength = 20;
      }
    ];
    environment.systemPackages = [pkgs.netcat];
  };

  testScript = ''
    droplet.wait_for_unit("multi-user.target")
    droplet.wait_for_unit("caddy.service")
    droplet.wait_for_unit("tailscaled.service")
    droplet.wait_for_unit("tailscale-nginx-auth.socket")
    droplet.wait_for_open_port(443)
    droplet.wait_for_open_port(80)

    with subtest("the config Caddy runs is the generated one"):
        droplet.succeed("grep -q 'Generated by ddm from sites.yaml (production)' /etc/caddy/caddy_config")
        droplet.succeed("systemctl show caddy -p Environment | grep -q TAILNET_OWNER=owner@github")

    with subtest("with autoDeploy off, nothing deploys by itself: no timer"):
        droplet.fail("systemctl cat ddm-deploy.timer")

    with subtest("Caddy can reach the Tailscale auth socket"):
        droplet.succeed("sudo -u caddy test -w /run/tailscale-nginx-auth/tailscale-nginx-auth.sock")

    with subtest("the publish root belongs to ddm"):
        droplet.succeed("test \"$(stat -c %U /var/www)\" = ddm")
        droplet.succeed("sudo -u ddm sh -c 'mkdir -p /var/www/public/ddm/x /var/www/public/docs/x /var/www/private/forest/x'")
        droplet.succeed("sudo -u ddm sh -c 'echo ddm-home > /var/www/public/ddm/x/index.html; echo not-found-page > /var/www/public/docs/x/404.html; echo private-forest > /var/www/private/forest/x/index.html'")
        for site in ["public/ddm", "public/docs", "private/forest"]:
            droplet.succeed(f"sudo -u ddm ln -sfn x /var/www/{site}/current")

    curl = "curl -sS --cacert /var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt"
    droplet.wait_until_succeeds("test -e /var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt")

    with subtest("a public mount serves its current publish"):
        droplet.wait_until_succeeds(f"{curl} https://ddm.cathe.dev/ | grep -q ddm-home")

    with subtest("every host serves its generated robots.txt"):
        droplet.succeed(f"{curl} -D /tmp/h https://ddm.cathe.dev/robots.txt > /tmp/robots")
        droplet.succeed("grep -qi 'content-type: text/plain' /tmp/h")
        droplet.succeed("grep -q 'robots.txt for ddm.cathe.dev' /tmp/robots")
        droplet.succeed("grep -A1 'User-agent: PanguBot' /tmp/robots | grep -q 'Disallow: /'")
        droplet.succeed("test \"$(tail -c1 /tmp/robots | od -An -c | tr -d ' ')\" = '\\n'")

    with subtest("plain http redirects to https"):
        droplet.succeed("curl -sS -o /dev/null -w '%{http_code} %{redirect_url}' http://ddm.cathe.dev/ | grep -q '308 https://ddm.cathe.dev/'")

    with subtest("an unknown subdomain gets the shared 404 page"):
        droplet.succeed(f"{curl} -o /tmp/body -w '%{{http_code}}' https://nosuch.cathe.dev/ | grep -q 404")
        droplet.succeed("grep -q not-found-page /tmp/body")

    with subtest("a private mount refuses a client outside the tailnet"):
        # Caddy aborts the connection: curl's "empty reply" (52), not a TLS error.
        droplet.succeed(f"code=0; {curl} --http1.1 https://the.cathe.dev/ || code=$?; test $code -eq 52")

    with subtest("only webSources reach the web ports; SSH stays open"):
        outsider.wait_for_unit("multi-user.target")
        # The droplet's addresses on the outsider's networks (by node order).
        for port in [80, 443]:
            outsider.succeed(f"nc -z -w 5 173.245.48.1 {port}")
            for addr in ["192.168.1.1", "2001:db8:1::1"]:
                outsider.fail(f"nc -z -w 5 {addr} {port}")
        outsider.succeed("nc -z -w 5 192.168.1.1 22")

    with subtest("a deploy unit builds and publishes a site, and records it"):
        # docs has no repo, so it builds offline. It replaces the fake publish above.
        droplet.succeed("systemctl start ddm-force@docs")
        droplet.succeed("grep -q '\"public/docs\"' /var/lib/ddm/work/state.json")
        droplet.succeed(f"{curl} -o /tmp/body -w '%{{http_code}}' https://nosuch.cathe.dev/ | grep -q 404")
        droplet.fail("grep -q not-found-page /tmp/body")
        droplet.succeed("grep -q '/_ddm/bar.js' /tmp/body")
  '';
}
